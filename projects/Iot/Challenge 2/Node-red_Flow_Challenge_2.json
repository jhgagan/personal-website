    {
        "id": "c617a03b.62f278",
        "type": "function",
        "z": "c85032a2.7190b",
        "name": "Multiple message decoder",
        "func": "//message = msg.payload['payload']\n// checking if there are multiple packets combined into one\n//packets = global.get(\"Packets\")\n\npacket = msg.payload\nif(msg.payload == \"START\"|| msg.payload == \"END\")\n{\n    return msg;\n}\nmessage = packet[\"payload\"]\n//message  = packet[\"Message\"]\nif(packet[\"payload\"]=== undefined)\n{\n    return msg;\n}\nelse\n{\n    if(message.includes(\"},\"))\n    {\n        multiple_messages =  message.split(\"},\")\n        msg.array = multiple_messages\n        payload = [multiple_messages.length]\n        for(var m = 0; m < multiple_messages.length;m++)\n        {\n            packet[\"payload\"] = multiple_messages[m]+\"}\"\n            payload[m] = packet\n            msg.payload = payload\n        }\n        return msg;\n    }\n    else\n    {\n        return msg\n    }\n    \n}",
        "outputs": 1,
        "noerr": 0,
