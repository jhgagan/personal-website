    {
        "id": "16c88ec5.7ad319",
        "type": "function",
        "z": "c85032a2.7190b",
        "name": "Filter Celsius",
        "func": "// assign the value of the recieved packet to a variable\npacket = msg.payload\n// check if the recieved packet has \nif(packet === undefined)\n{\n    return;\n}\nelse\n{\n    // check if the recieved packet has a payload\n    if(packet.includes(\"payload\"))\n    {\n        // find the start and end positions of the payload and assign it to the payload variable\n        payload_start = packet.search(\"payload\")+11\n        payload_end = packet.length - 4\n        payload = packet.slice(payload_start,payload_end)\n        msg.filter = payload\n        // check if the payload has temperature of unit C (Celcius)\n        if(payload.includes(\"C\"))\n        {\n            msg.packet = packet\n            // find the value of tempereature\n            split_payload = payload.split(\" \").join(\",\").split(\"\\\"\").join(\",\").split(\"\\\\\").join(\",\").split(\":\").join(\",\").split(\",\")\n            filter_split =[]\n            for(var i = 0; i< split_payload.length; i++)\n            {\n                if(split_payload[i] !== \"\")\n                {\n                 filter_split.push(split_payload[i])   \n                }\n            }\n           // split(\" \").join(\",\").split(\":\").join(\",\").split(\"\\\\\").join(\",\").split(\"\\\"\").join(\",\").split(\",\")\n            \n            // find the index of the \"range\" term\n            range_index = filter_split.indexOf(\"range\")\n            \n            // string contaning the value\n            temp_range = filter_split[range_index+1]+\",\"+filter_split[range_index+2]\n            \n            // remove the brackets and the comma and separate the two numbers\n            temp_range = temp_range.slice(1,temp_range.length-1)\n            temp_values = temp_range.split(\",\")\n            msg.temp = temp_values[temp_values.length-1]\n            return msg\n        }\n        else\n        {\n            msg.split = \"Nothing to see here\"\n            msg.value = \"NOOO\"\n            return msg\n        }\n        \n    }\n}\n",
        "outputs": 1,
        "noerr": 0,
        "x": 370,
        "y": 660,
