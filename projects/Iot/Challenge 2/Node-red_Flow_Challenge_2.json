    {
        "id": "f018bfd.1b6c34",
        "type": "function",
        "z": "c85032a2.7190b",
        "name": "ID filter",
        "func": "/*Collect the data only if the count is less than 100\nand greater than 0*/\npacket = msg.packets\nif(global.get(\"count\")==-1)\n{\n    msg.payload = \"START\"\n    global.set(\"count\",global.get(\"count\")+1)\n    return msg\n}\nelse if(global.get(\"count\")==100)\n{\n    msg.payload = \"END\"\n    global.set(\"count\",global.get(\"count\")+1)\n    return msg;\n}\nif(global.get(\"count\")<100&&global.get(\"count\")>=0)\n{\n    // update the count value\n    global.set(\"count\", global.get(\"count\")+1)\n    //Filter the data to obtain the id\n    string = msg.payload\n    //search for the id sub string in the string    \n    // the id value starts 5 positions after id\n    id_start = string.search(\"id\")+5\n    // id value ends 2 positions before the string length\n    id_end = string.length-2\n    // slice the string to obtain the id value\n    id = string.slice(id_start,id_end)\n    // calculate the n value\n    var n = ((id*1+1210)%7711)\n    global.set(\"n\",n)\n    \n    msg.data = \"n: \"+n+\" count: \"+global.get(\"count\")\n    // selecting the packet that has been read from the csv file\n    msg.payload = global.get(\"Packets\")[n-1]\n    return msg;\n}\n",
        "outputs": 1,
        "noerr": 0,
        "x": 320,
        "y": 220,
        "wires": [
            [
                "a83882b3.66e14",
                "4c5aef28.7465e8",
                "7dc5a284.4ef6ac"
            ]
        ]
    },
