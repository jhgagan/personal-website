    {
        "id": "4c5aef28.7465e8",
        "type": "function",
        "z": "c85032a2.7190b",
        "name": "Message publish selector",
        "func": "// if it is the \"start\" of the \"end\"\nif(msg.payload == \"START\" || msg.payload == \"END\")\n{\n    return msg;\n}\n// check if payload is undefined\nelse if(msg.payload['Info'] === undefined)\n{\n    return\n}\nelse\n{\n    // assign the msg payload to the packet variable\n    packet = msg.payload\n    Info = packet['Info']\n    // check if the packet variable has Publish message in its Info\n    if(Info.includes(\"Publish Message\"))\n    {   \n        const publish_payload = {}\n        publish_payload.timestamp = Date.now()\n        publish_payload.id = global.get(\"n\")\n        publish_payload.payload = packet['Message']\n        msg.payload = publish_payload\n        return msg;\n    }\n   \n}",
        "outputs": 1,
        "noerr": 0,
        "x": 560,
        "y": 220,
        "wires": [
